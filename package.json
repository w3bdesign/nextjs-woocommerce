{
  "name": "nextjs-woocommerce",
  "version": "1.2.5",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lhci": "lhci autorun",
    "lhci:perf": "lhci autorun --collect.settings.preset=perf",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\"",
    "playwright": "pnpm exec playwright test",
    "playwright:ui": "pnpm exec playwright test --ui",
    "playwright:debug": "pnpm exec playwright test --debug",
    "playwright:codegen": "pnpm exec playwright codegen",
    "doctor": "echo n | react-doctor --verbose",
    "doctor:score": "echo n | react-doctor --score",
    "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm install && pnpm run format"
  },
  "keywords": [
    "next.js",
    "portfolio",
    "next",
    "javascript",
    "framer"
  ],
  "author": "w3bdesign",
  "license": "AGPL-3.0",
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "algoliasearch": "^5.59.0",
    "graphql": "^17.0.2",
    "motion": "^14.11.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-instantsearch": "^7.52.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "pa11y": "^10.0.0",
    "postcss": "~8.5.32",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
